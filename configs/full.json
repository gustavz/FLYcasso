{
  "graph": "data/processed/malecns/graph.npz",
  "dataset": "data/processed/cifar10",
  "seed": 42,
  "threads": 2,
  "image_size": 32,
  "width": 128,
  "recurrent_steps": 3,
  "leak": 0.5,
  "diffusion_steps": 1000,
  "batch_size": 32,
  "train_steps": 20000,
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "gradient_clip": 1.0,
  "ema_decay": 0.999,
  "checkpoint_every": 250,
  "validate_every": 250,
  "validation_batches": 8,
  "log_every": 10,
  "allow_synthetic": false,
  "graph_control": "real",
  "architecture": "unet",
  "classes": [
    "airplane",
    "automobile",
    "bird",
    "cat",
    "deer",
    "dog",
    "frog",
    "horse",
    "ship",
    "truck"
  ],
  "min_snr_gamma": 5,
  "residual_blocks": true,
  "readout_lr_scale": 0.0007678464307138572,
  "condition_dropout": 0.1,
  "guidance_scale": 2.0,
  "synaptic_output": true
}
